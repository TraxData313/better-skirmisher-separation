<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>BetterSkirmisherSeparation</RootNamespace>
    <AssemblyName>BetterSkirmisherSeparation</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ModuleFolder>$(MSBuildThisFileDirectory)..\..\module</ModuleFolder>
    <OutputPath>$(ModuleFolder)\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the .NET SDK build net472 without a Visual Studio targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Mod Configuration Menu: a SOFT runtime dependency. Referenced to compile the settings page but never
       copied to our bin (the MCM module provides MCMv5.dll). Without MCM the mod runs on the defaults. -->
  <ItemGroup>
    <Reference Include="MCMv5">
      <HintPath>$(McmBinFolder)\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony and the game assemblies are referenced from the local install and never copied to output -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyBinFolder)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Install: mirror module\ into the game's Modules\BetterSkirmisherSeparation (that folder only) -->
  <Target Name="DeployToGameModules" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameFolder)\Modules')">
    <ItemGroup>
      <ModuleFiles Include="$(ModuleFolder)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'$(GameFolder)\Modules\BetterSkirmisherSeparation\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(GameFolder)\Modules\BetterSkirmisherSeparation" />
  </Target>

</Project>
